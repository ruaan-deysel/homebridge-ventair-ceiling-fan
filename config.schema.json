{
  "pluginAlias": "HomebridgeVentairCeilingFan",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "headerDisplay": "Control Ventair Skyfan DC ceiling fans locally over your network. Your configured fans are listed below \u2014 scan to find more, or paste a local key directly into any fan.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "required": true,
        "default": "Skyfan DC Ceiling Fan"
      },
      "devices": {
        "type": "array",
        "title": "Fans",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "title": "Name",
              "required": true,
              "description": "Shown in the Home app, e.g. Lounge Room Fan"
            },
            "id": {
              "type": "string",
              "title": "Device ID",
              "required": true,
              "description": "Tuya device ID"
            },
            "key": {
              "type": "string",
              "title": "Local Key",
              "required": true,
              "format": "password",
              "minLength": 16,
              "maxLength": 16,
              "description": "16-character Tuya local key"
            },
            "hasLight": {
              "type": "boolean",
              "title": "Fan has a light",
              "default": false,
              "description": "Enable only if your fan has an integrated light. Light support is currently untested."
            },
            "exposeModeSwitches": {
              "type": "boolean",
              "title": "Expose mode switches",
              "default": false,
              "description": "Adds a Sleep switch to this fan in the Home app. Only Normal and Sleep are known to be writable over the LAN, so no other mode is exposed. Fans can report other modes (an Eco mode has been seen) when changed from the Tuya app; those are read correctly but cannot be set from HomeKit."
            },
            "ip": {
              "type": "string",
              "title": "IP Address",
              "required": false,
              "description": "Leave blank to discover automatically."
            },
            "version": {
              "type": "string",
              "title": "Protocol Version",
              "required": false,
              "description": "Leave blank to use the version the fan announces during discovery (usually 3.3).",
              "oneOf": [
                {
                  "title": "3.1",
                  "enum": [
                    "3.1"
                  ]
                },
                {
                  "title": "3.2",
                  "enum": [
                    "3.2"
                  ]
                },
                {
                  "title": "3.3",
                  "enum": [
                    "3.3"
                  ]
                },
                {
                  "title": "3.4",
                  "enum": [
                    "3.4"
                  ]
                },
                {
                  "title": "3.5",
                  "enum": [
                    "3.5"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  },
  "layout": [
    {
      "key": "name"
    },
    {
      "key": "devices",
      "type": "array",
      "title": "Fans",
      "items": [
        "devices[].name",
        "devices[].id",
        "devices[].key",
        "devices[].hasLight",
        "devices[].exposeModeSwitches",
        {
          "type": "fieldset",
          "title": "Advanced",
          "expandable": true,
          "expanded": false,
          "items": [
            "devices[].ip",
            "devices[].version"
          ]
        }
      ]
    }
  ]
}
